# Copy this file to .env and fill in the values. Never commit .env.

# AI provider (any OpenAI-compatible API)
LLM_BASE_URL=https://api.groq.com/openai/v1
# A local server (for example Ollama) needs no real key: any non-empty value works.
LLM_API_KEY=
LLM_MODEL=

# Speech-to-text. Leave the URL and key empty to use the same provider as above.
TRANSCRIBE_BASE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Front-end addresses allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Largest request the server accepts, in MB (five 25 MB slide files, 25 MB of audio, and notes)
MAX_REQUEST_MB=160

# Further reading (phase 6)
YOUTUBE_API_KEY=
NCBI_API_KEY=

# Hosted demo protection (phase 10)
ACCESS_CODE=
