# Copy this file to .env and fill in the values. Never commit .env.

# AI provider (any OpenAI-compatible API)
LLM_BASE_URL=https://api.groq.com/openai/v1
# A local server (for example Ollama) needs no real key: any non-empty value works.
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Tokens per minute allowed by the provider's plan (Groq free tier: 8000). Limits how much material fits in one study pack.
LLM_TOKENS_PER_MINUTE=8000
# For reasoning models (low, medium, high). Leave empty for providers or models that do not support it.
LLM_REASONING_EFFORT=low

# Speech-to-text. Leave the URL and key empty to use the same provider as above.
TRANSCRIBE_BASE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# A model that can read images, for photos of handwritten notes (same provider as the LLM)
VISION_MODEL=qwen/qwen3.8-27b

# Front-end addresses allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Largest request the server accepts, in MB (five 25 MB slide files, 25 MB of audio, five 15 MB photos)
MAX_REQUEST_MB=240

# Further reading
# YouTube Data API v3 key (free, 10,000 units a day; WardWise uses about 80). In Google Cloud, restrict it to
# the YouTube Data API v3. Left empty, the videos are left out and everything else still works.
YOUTUBE_API_KEY=
# Optional NCBI key for PubMed and StatPearls: 10 requests a second instead of 3.
NCBI_API_KEY=

# Hosted demo protection (phase 10)
ACCESS_CODE=
